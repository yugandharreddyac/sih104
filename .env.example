# =============================================================================
# VOXSHIELD Root Orchestration Environment Variables
# =============================================================================

# PostgreSQL
POSTGRES_USER=voxshield_user
POSTGRES_PASSWORD=voxshield_secure_pass
POSTGRES_DB=voxshield_db

# Redis
