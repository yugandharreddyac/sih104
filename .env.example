# Security Secrets (Override in production!)
JWT_SECRET=voxshield_super_secure_jwt_secret_dev_key_2026!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
WEBHOOK_SECRET=voxshield_default_dev_webhook_secret_2026

# External Integrations
INTERVENTION_WEBHOOK_URL=
