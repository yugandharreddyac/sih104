# AI / ML Binary Model Weights (Protected from Git tracking)
*.pt
*.pth
*.onnx
*.bin
*.safetensors
*.ckpt
*.h5
*.pkl
*.model
*.tflite

# Model Staging Directories (Track READMEs and .gitkeep only)
ai/models/*
!ai/models/**/README.md
!ai/models/**/.gitkeep

# Raw Audio Files & Test Recordings
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac

# Benchmark Datasets & Raw Data Storage (Keep structure, READMEs, manifests; ignore audio/archives)
datasets/raw/*
!datasets/raw/**/.gitkeep
!datasets/raw/**/README.md
datasets/processed/*
!datasets/processed/**/.gitkeep
!datasets/processed/**/README.md
!datasets/README.md
!datasets/**/.gitkeep
!datasets/metadata/
!datasets/metadata/**
datasets/**/*.tar
datasets/**/*.tar.gz
datasets/**/*.zip
datasets/**/*.7z
data/raw/
data/cache/
evaluation/data/

