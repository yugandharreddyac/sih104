# =============================================================================
# VOXSHIELD Core Backend Environment Configuration
# =============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Authentication & Security
# WARNING: Change JWT_SECRET and ENCRYPTION_KEY in production!
JWT_SECRET=voxshield_super_secure_jwt_secret_dev_key_2026!
JWT_EXPIRES_IN=8h
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# Database & Cache
DATABASE_URL=postgresql://voxshield_user:voxshield_secure_pass@localhost:5432/voxshield_db
PERSISTENCE_MODE=fallback
REDIS_URL=redis://localhost:6379

# AI Microservice URL
AI_SERVICE_URL=http://localhost:8000

# Telephony / RTP Ingestion
TELEPHONY_ENABLED=true
RTP_UDP_HOST=0.0.0.0
RTP_UDP_PORT=10000

# Outbound Intervention Webhook
INTERVENTION_WEBHOOK_URL=http://localhost:4000/api/interventions/mock-webhook
WEBHOOK_SECRET=voxshield_default_dev_webhook_secret_2026
